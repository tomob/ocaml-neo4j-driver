bug-reports: "https://github.com/tomob/ocaml-neo4j-driver/issues"
depends: [
  "dune" {>= "3.13"}
  "ocaml" {>= "5.2.0"}
  "ppxlib" {>= "0.33.0"}
  "neodriver_core" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tomob/ocaml-neo4j-driver.git"
