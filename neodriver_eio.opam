  "dune" {>= "3.13" & >= "3.13"}
  "neodriver_core" {= version}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "ipaddr" {>= "5.5"}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
